<script>

/* =========================================================
   COURTS DATA
========================================================= */

const newCourts = [

{
    id:1,
    name:"أدرار",
    info:"محكمة تجارية متخصصة تم تنصيبها ضمن الدفعة الجديدة في سبتمبر 2026.",
    jurisdiction:"أدرار، تيميمون، إن صالح"
},

{
    id:2,
    name:"الشلف",
    info:"محكمة تجارية متخصصة جديدة ضمن التوسعة الوطنية لسنة 2026.",
    jurisdiction:"الشلف، عين الدفلى"
},

{
    id:3,
    name:"باتنة",
    info:"محكمة تجارية متخصصة جديدة ضمن الدفعة المنصبة في سبتمبر 2026.",
    jurisdiction:"باتنة، بسكرة، أولاد جلال"
},

{
    id:4,
    name:"بجاية",
    info:"محكمة تجارية متخصصة جديدة ضمن التوسعة الوطنية.",
    jurisdiction:"دائرة الاختصاص وفق الملحق التنظيمي"
},

{
    id:5,
    name:"تبسة",
    info:"محكمة تجارية متخصصة جديدة تم تنصيبها في سبتمبر 2026.",
    jurisdiction:"دائرة الاختصاص وفق الملحق التنظيمي"
},

{
    id:6,
    name:"تيارت",
    info:"محكمة تجارية متخصصة جديدة ضمن الدفعة الثانية من المحاكم.",
    jurisdiction:"دائرة الاختصاص وفق الملحق التنظيمي"
},

{
    id:7,
    name:"سعيدة",
    info:"محكمة تجارية متخصصة جديدة ضمن التوسعة الوطنية.",
    jurisdiction:"دائرة الاختصاص وفق الملحق التنظيمي"
},

{
    id:8,
    name:"قالمة",
    info:"محكمة تجارية متخصصة جديدة تم تنصيبها في سبتمبر 2026.",
    jurisdiction:"دائرة الاختصاص وفق الملحق التنظيمي"
},

{
    id:9,
    name:"البيض",
    info:"محكمة تجارية متخصصة جديدة ضمن التوسعة الوطنية.",
    jurisdiction:"دائرة الاختصاص وفق الملحق التنظيمي"
},

{
    id:10,
    name:"إليزي",
    info:"محكمة تجارية متخصصة جديدة تم تنصيبها في سبتمبر 2026.",
    jurisdiction:"دائرة الاختصاص وفق الملحق التنظيمي"
},

{
    id:11,
    name:"بومرداس",
    info:"محكمة تجارية متخصصة جديدة ضمن التوسعة الوطنية.",
    jurisdiction:"دائرة الاختصاص وفق الملحق التنظيمي"
},

{
    id:12,
    name:"الوادي",
    info:"محكمة تجارية متخصصة جديدة تم تنصيبها في سبتمبر 2026.",
    jurisdiction:"دائرة الاختصاص وفق الملحق التنظيمي"
},

{
    id:13,
    name:"غرداية",
    info:"محكمة تجارية متخصصة جديدة ضمن التوسعة الوطنية.",
    jurisdiction:"دائرة الاختصاص وفق الملحق التنظيمي"
}

];


/* =========================================================
   RENDER COURTS
========================================================= */

function renderCourts(list){

    const container =
        document.getElementById("courtList");

    container.innerHTML="";

    list.forEach(court => {

        const element =
            document.createElement("article");

        element.className="court";

        element.innerHTML=`

            <div class="court-number">
                ${court.id}
            </div>

            <h3>
                المحكمة التجارية المتخصصة
                - ${court.name}
            </h3>

            <p>
                ${court.info}
            </p>

            <br>

            <p>
                <strong>
                    الاختصاص الإقليمي:
                </strong>
                ${court.jurisdiction}
            </p>

            <br>

            <button
                class="btn btn-primary"
                onclick="openCourt(${court.id})">

                التفاصيل

            </button>

        `;

        container.appendChild(element);

    });

}


/* =========================================================
   COURT SEARCH
========================================================= */

function searchCourts(){

    const query =
        document
        .getElementById("courtSearch")
        .value
        .trim()
        .toLowerCase();

    const result =
        newCourts.filter(court => {

            return (
                court.name
                .toLowerCase()
                .includes(query)
            );

        });

    renderCourts(result);

}


function showAllCourts(){

    document
    .getElementById("courtSearch")
    .value="";

    renderCourts(newCourts);

}


/* =========================================================
   COURT MODAL
========================================================= */

function openCourt(id){

    const court =
        newCourts.find(
            item => item.id === id
        );

    if(!court) return;

    document
    .getElementById("modalContent")
    .innerHTML=`

        <h2>
            المحكمة التجارية المتخصصة -
            ${court.name}
        </h2>

        <div class="detail">

            <h4>
                الوضع في سبتمبر 2026
            </h4>

            <p>
                ${court.info}
            </p>

        </div>

        <div class="detail">

            <h4>
                الاختصاص الإقليمي
            </h4>

            <p>
                ${court.jurisdiction}
            </p>

        </div>

        <div class="detail">

            <h4>
                ملاحظة للطالب
            </h4>

            <p>

                ينبغي دائمًا الرجوع إلى النص التنظيمي
                الساري عند دراسة الاختصاص الإقليمي،
                لأن الاختصاص لا يستنتج من اسم المحكمة
                وحده.

            </p>

        </div>

    `;

    document
    .getElementById("modal")
    .classList.add("show");

}


/* =========================================================
   MODAL
========================================================= */

function closeModal(){

    document
    .getElementById("modal")
    .classList.remove("show");

}


function closeOutside(event){

    if(event.target.id==="modal"){

        closeModal();

    }

}


document.addEventListener(
    "keydown",
    function(event){

        if(event.key==="Escape"){

            closeModal();

        }

    }
);


/* =========================================================
   QUIZ
========================================================= */

function calculateQuiz(){

    const answers={

        q1:"b",
        q2:"b",
        q3:"a",
        q4:"a",
        q5:"b"

    };

    let score=0;

    Object.keys(answers).forEach(
        question => {

            const selected =
                document.querySelector(
                    `input[name="${question}"]:checked`
                );

            if(
                selected &&
                selected.value === answers[question]
            ){

                score++;

            }

        }
    );


    const result =
        document.getElementById("result");

    result.style.display="block";


    if(score===5){

        result.style.background="#d1e7dd";
        result.style.color="#0f5132";

        result.innerHTML=`

            <strong>
                ممتاز جدًا! 🎓
            </strong>

            <br>

            حصلت على 5/5.
            لديك فهم ممتاز للمعلومات الأساسية.

        `;

    }

    else if(score>=3){

        result.style.background="#fff3cd";
        result.style.color="#664d03";

        result.innerHTML=`

            <strong>
                نتيجة جيدة 👍
            </strong>

            <br>

            حصلت على
            ${score}/5.

            راجع المحاور وأعد الاختبار.

        `;

    }

    else{

        result.style.background="#f8d7da";
        result.style.color="#842029";

        result.innerHTML=`

            <strong>
                تحتاج إلى مراجعة 📚
            </strong>

            <br>

            حصلت على
            ${score}/5.

            ننصحك بإعادة قراءة محاور الاختصاص
            والتحديثات القانونية.

        `;

    }

}


/* =========================================================
   NAVIGATION
========================================================= */

function go(id){

    const element =
        document.getElementById(id);

    if(element){

        element.scrollIntoView({
            behavior:"smooth"
        });

    }

    document
    .getElementById("nav")
    .classList.remove("open");

}


/* =========================================================
   MOBILE MENU
========================================================= */

function toggleMenu(){

    document
    .getElementById("nav")
    .classList.toggle("open");

}


/* =========================================================
   DARK MODE
========================================================= */

function toggleDark(){

    document.body
    .classList.toggle("dark");

    localStorage.setItem(
        "courtDarkMode",
        document.body.classList.contains("dark")
        ? "on"
        : "off"
    );

}


if(
    localStorage.getItem("courtDarkMode")
    === "on"
){

    document.body.classList.add("dark");

}


/* =========================================================
   TOP BUTTON
========================================================= */

window.addEventListener(
    "scroll",
    function(){

        const button =
            document.getElementById("topButton");

        if(window.scrollY>500){

            button.style.display="block";

        }

        else{

            button.style.display="none";

        }

    }
);


function goTop(){

    window.scrollTo({

        top:0,

        behavior:"smooth"

    });

}


/* =========================================================
   INITIALIZATION
========================================================= */

renderCourts(newCourts);

</script>


</body>
</html>
